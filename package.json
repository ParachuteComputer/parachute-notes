{
  "name": "@openparachute/notes-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo root for @openparachute/notes (module) and @openparachute/notes-ui (UI bundle).",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/ParachuteComputer/parachute-notes.git"
  },
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run --filter @openparachute/notes-ui dev",
    "build": "bun run --filter @openparachute/notes-ui build && bun run --filter @openparachute/notes build",
    "test": "bun run --filter @openparachute/notes-ui test && bun run --filter @openparachute/notes test",
    "typecheck": "bun run --filter @openparachute/notes-ui typecheck",
    "lint": "bun run --filter @openparachute/notes-ui lint",
    "lint:fix": "bun run --filter @openparachute/notes-ui lint:fix",
    "format": "bun run --filter @openparachute/notes-ui format"
  }
}
